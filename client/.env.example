# EmailJS configuration for the waitlist + contact emails.
# Copy this file to client/.env and fill in the values from https://dashboard.emailjs.com
# (Vite only exposes vars prefixed with VITE_ to the browser.)

# Account > General > Public Key
VITE_EMAILJS_PUBLIC_KEY=

# Email Services > (your service) > Service ID
VITE_EMAILJS_SERVICE_ID=

# Email Templates > waitlist welcome template > Template ID
VITE_EMAILJS_WAITLIST_TEMPLATE_ID=

# Email Templates > contact message template > Template ID
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
